{
    "dataRoles": [
        {
            "displayName": "Customer ID", "displayNameKey": "Role_CustomerId",
            "name": "customer_id",
            "kind": "GroupingOrMeasure",
            "description": "Unique identifier for each point of sale", "descriptionKey": "Role_CustomerId_Desc"
        },
        {
            "displayName": "Latitude", "displayNameKey": "Role_Latitude",
            "name": "latitude",
            "kind": "Measure",
            "description": "Geographic latitude of the point of sale", "descriptionKey": "Role_Latitude_Desc"
        },
        {
            "displayName": "Longitude", "displayNameKey": "Role_Longitude",
            "name": "longitude",
            "kind": "Measure",
            "description": "Geographic longitude of the point of sale", "descriptionKey": "Role_Longitude_Desc"
        },
        {
            "displayName": "Visits per month", "displayNameKey": "Role_Visits",
            "name": "visits",
            "kind": "Measure",
            "description": "Monthly visit frequency for this point of sale. Optional: with Minutes per visit, the workload is visits x (minutes + travel).", "descriptionKey": "Role_Visits_Desc"
        },
        {
            "displayName": "Minutes per visit", "displayNameKey": "Role_Minutes",
            "name": "minutes",
            "kind": "Measure",
            "description": "Time spent per visit, in minutes. Optional; used together with Visits per month.", "descriptionKey": "Role_Minutes_Desc"
        },
        {
            "displayName": "Speed (km/h) (Pro)", "displayNameKey": "Role_Speed",
            "name": "speed",
            "kind": "Measure",
            "description": "Pro: travel time per point instead of one speed for everybody. Average speed around this point of sale (e.g. urban 25, semi-urban 45, rural 70); overrides the km/h in the bar. Without Pro it shows as a watermarked preview while editing.", "descriptionKey": "Role_Speed_Desc"
        },
        {
            "displayName": "Postal code", "displayNameKey": "Role_Postal",
            "name": "postal",
            "kind": "Grouping",
            "description": "Optional postal code (or any basic area such as municipality). Areas are always built from whole postal codes: a postal code is never split between areas.", "descriptionKey": "Role_Postal_Desc"
        },
        {
            "displayName": "Area (Pro)", "displayNameKey": "Role_Area",
            "name": "area",
            "kind": "Grouping",
            "description": "Pro: size the sales force by your own areas (province, sales region...) instead of automatic ones. Without Pro it shows as a watermarked preview while editing; free, leave it empty and type a number of Areas in the bar.", "descriptionKey": "Role_Area_Desc"
        },
        {
            "displayName": "Tooltips", "displayNameKey": "Role_Tooltips",
            "name": "tooltips",
            "kind": "Measure",
            "description": "Optional extra values shown in the tooltip of each point of sale (sales, segment...).", "descriptionKey": "Role_Tooltips_Desc"
        }
    ],
    "dataViewMappings": [
        {
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "customer_id" } },
                        { "for": { "in": "latitude" } },
                        { "for": { "in": "longitude" } },
            {
                "for": {
                    "in": "visits"
                }
            },
            {
                "for": {
                    "in": "minutes"
                }
            },
            {
                "for": {
                    "in": "speed"
                }
            },
            {
                "for": {
                    "in": "postal"
                }
            },
            {
                "for": {
                    "in": "area"
                }
            },
            {
                "for": {
                    "in": "tooltips"
                }
            }
                    ],
                    "dataReductionAlgorithm": {
                        "window": { "count": 30000 }
                    }
                }
            }
        }
    ],
    "objects": {
        "general": {
            "displayName": "General", "displayNameKey": "Obj_General",
            "properties": {
                "filter": { "type": { "filter": true } }
            }
        },
        "clusterSettings": {
            "displayName": "Territories", "displayNameKey": "Obj_Territories",
            "properties": {
                "capacityHours": {
                    "displayName": "Hours / salesperson / month", "displayNameKey": "Prop_Capacity",
                    "description": "Field hours available per month for ONE salesperson, visits and travel included: the size of a territory. The number of salespeople is derived from it.", "descriptionKey": "Prop_Capacity_Desc",
                    "type": {
                        "numeric": true
                    }
                },
                "speedKmh": {
                    "displayName": "Average speed (km/h)", "displayNameKey": "Prop_Speed",
                    "description": "Converts distance into travel time.", "descriptionKey": "Prop_Speed_Desc",
                    "type": {
                        "numeric": true
                    }
                },
                "detour": {
                    "displayName": "Road factor", "displayNameKey": "Prop_Detour",
                    "description": "Road distance over straight line: 1.3 means 30% longer than the straight line.", "descriptionKey": "Prop_Detour_Desc",
                    "type": {
                        "numeric": true
                    }
                },
                "workDays": {
                    "displayName": "Working days / month", "displayNameKey": "Prop_WorkDays",
                    "description": "Working days a month. A working day is the salesperson's monthly hours divided by this; the visits that fit in a day share the daily trip out to the territory and back.", "descriptionKey": "Prop_WorkDays_Desc",
                    "type": {
                        "numeric": true
                    }
                },
                "outlierKm": {
                    "displayName": "Outlier distance (km)", "displayNameKey": "Prop_OutlierKm",
                    "description": "A point of sale whose third-nearest neighbour is farther than this is left out of the territories and flagged as an outlier. 0 = never.", "descriptionKey": "Prop_OutlierKm_Desc",
                    "type": {
                        "numeric": true
                    }
                },
                "areas": {
                    "displayName": "Areas (automatic)", "displayNameKey": "Prop_Areas",
                    "description": "Number of geographic commercial areas to draw when no Area field is bound; territories are built inside each. 0 = no areas.", "descriptionKey": "Prop_Areas_Desc",
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "areaBadges": {
            "displayName": "Area badges", "displayNameKey": "Obj_AreaBadges",
            "description": "A circle or a rectangle on each area with the number of salespeople it needs.", "descriptionKey": "Obj_AreaBadges_Desc",
            "properties": {
                "show": { "displayName": "Show", "displayNameKey": "Prop_Show", "type": { "bool": true } },
                "shape": { "displayName": "Shape", "displayNameKey": "Prop_BadgeShape", "type": { "enumeration": [
                    { "value": "circle", "displayName": "Circle", "displayNameKey": "Enum_Circle" },
                    { "value": "rect", "displayName": "Rectangle", "displayNameKey": "Enum_Rectangle" } ] } },
                "fontSize": { "displayName": "Font size", "displayNameKey": "Prop_FontSize", "type": { "formatting": { "fontSize": true } } },
                "fontFamily": { "displayName": "Font family", "displayNameKey": "Prop_FontFamily", "type": { "formatting": { "fontFamily": true } } },
                "fillColor": { "displayName": "Background color", "displayNameKey": "Prop_FillColor", "type": { "fill": { "solid": { "color": true } } } },
                "textColor": { "displayName": "Text color", "displayNameKey": "Prop_TextColor", "type": { "fill": { "solid": { "color": true } } } },
                "borderColor": { "displayName": "Border color", "displayNameKey": "Prop_BorderColor", "type": { "fill": { "solid": { "color": true } } } },
                "borderWidth": { "displayName": "Border width", "displayNameKey": "Prop_BorderWidth", "type": { "numeric": true } }
            }
        },
        "mapSettings": {
            "displayName": "Map Settings", "displayNameKey": "Obj_Map",
            "properties": {
                "markerSize": {
                    "displayName": "Marker Size", "displayNameKey": "Prop_MarkerSize",
                    "type": { "numeric": true }
                }
            }
        }
    },
    "supportsHighlight": true,
    "tooltips": {
        "supportedTypes": { "default": true, "canvas": true },
        "roles": ["tooltips"]
    },
    "supportsSynchronizingFilterState": true,
    "supportsLandingPage": true,
    "supportsKeyboardFocus": true,
    "supportsMultiVisualSelection": true,
    "privileges": [
        {
            "name": "ExportContent",
            "essential": false
        }
    ]
}
